NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/style_companion?schema=public

# Auth
AUTH_REQUIRED=true
FIREBASE_AUTH_MODE=mock
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe Connect
STRIPE_CONNECT_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_REFRESH_URL=https://api.example.com/payments/connect/refresh
STRIPE_CONNECT_RETURN_URL=https://api.example.com/payments/connect/return

# Twilio Conversations
TWILIO_CONVERSATIONS_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_CONVERSATIONS_SERVICE_SID=

# S3-compatible media storage
MEDIA_STORAGE_MODE=mock
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Firebase Cloud Messaging
FCM_MODE=mock
